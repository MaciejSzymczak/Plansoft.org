    WordWrap = False
  end
  object sqlRes_no_aggr: TMemo
    Left = 584
    Top = 464
    Width = 185
    Height = 89
    Lines.Strings = (
      'select cla_id Id'
      '     , gou.name  orguni'
      '     , g.name||'#39' '#39'||g.attribs_01 res_name'
      
        '     , (count(1) over (partition by cla_id order by cla_id)) rco' +
        'unt'
      '     , g.integration_id'
      ' from rooms   g'
      '    , rom_cla  c'
      '    , org_units  gou'
      'where g.id = c.rom_id'
      '  and g.orguni_id = gou.id(+)'
      '  AND c.IS_CHILD = '#39'N'#39)
    TabOrder = 9
    Visible = False
    WordWrap = False
  end
  object sqlGroups_no_aggr: TMemo
    Left = 392
    Top = 464
    Width = 185
    Height = 89
    Lines.Strings = (
      'select cla_id Id'
      '     , to_number(number_of_peoples) nop'
      '     , substr(meaning,1,50)  group_type_dsp'
      '     , gou.name  orguni'
      '     , nvl(g.name, g.abbreviation) group_name'
      
        '     , (SELECT LISTAGG(gg.abbreviation, '#39'; '#39') WITHIN GROUP (ORDE' +
        'R BY gg.abbreviation) FROM str_elems se, groups gg WHERE se.pare' +
        'nt_id = gg.id and se.child_id = g.id) parent_group'
      
        '     , (count(1) over (partition by cla_id order by cla_id)) gco' +
        'unt'
      '     , g.integration_id'
      ' from groups   g'
      '    , gro_cla  c'
      '    , org_units  gou'
      '    , lookups  l'
      'where g.id = c.gro_id'
      '  and g.orguni_id = gou.id(+)'
      '  and l.lookup_type(+) = '#39'GROUP_TYPE'#39
      '  and l.code(+)  = g.group_type'
      '  AND c.IS_CHILD = '#39'N'#39)
    TabOrder = 10
    Visible = False
    WordWrap = False
  end
  object sqlLecturers_no_aggr: TMemo
    Left = 200
    Top = 464
    Width = 185
    Height = 89
    Lines.Strings = (
      'select title ||'#39' '#39'||first_name||'#39' '#39'||last_name  full_name'
      '     , title'
      '     , first_name'
      '     , last_name'
      '     , o.name  orguni'
      '     , lec_cla.cla_id Id'
      
        '     , lec_cla.desc1 ldesc1, lec_cla.desc2 ldesc2, lec_cla.desc3' +
        ' ldesc3, lec_cla.desc4 ldesc4'
      
        '     , (count(1) over (partition by cla_id order by cla_id)) lco' +
        'unt'
      '     , lecturers.integration_id'
      '  from lec_cla'
      '      , lecturers'
      '      , org_units o'
      '  where lec_cla.lec_id = lecturers.id'
      '    AND lec_cla.IS_CHILD = '#39'N'#39
      '    and o.id(+) = lecturers.orguni_id')
    TabOrder = 11
    Visible = False
    WordWrap = False
  end
