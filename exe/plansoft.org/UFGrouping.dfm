  object Query: TADOQuery
    Connection = DModule.ADOConnection
    CursorLocation = clUseServer
    Parameters = <>
    SQL.Strings = (
      'SELECT '#39#39
      '     , DAY'
      '     , HOUR'
      '     , CALC_LECTURERS'
      '     , CALC_GROUPS'
      '     , CALC_ROOMS'
      '     , FILL,SUB.NAME'
      '     , FRM.NAME'
      '     , COUNT(*) LICZBA'
      'FROM CLASSES'
      '   , SUBJECTS SUB'
      '   , FORMS FRM'
      'WHERE FOR_ID = FRM.ID AND SUB_ID = SUB.ID'
      
        'GROUP BY DAY, HOUR, CALC_LECTURERS, CALC_GROUPS, CALC_ROOMS, FIL' +
        'L,SUB.NAME, FRM.NAME')
    Left = 497
    Top = 362
  end
