    object TabSheet3: TTabSheet
      Caption = 'Zaawansowane - css'
      ImageIndex = 2
      object css: TMemo
        Left = 0
        Top = 0
        Width = 1480
        Height = 494
        Align = alClient
        Lines.Strings = (
          '/* Wygl'#261'd strony index.html (spis tre'#347'ci). Zmiany zapisuj'#261' si'#281' w programie i trafiaj'#261' do pliku menu.css. */'
          'body {'
          #9'font-variant: small-caps;'
          #9'text-align: center;'
          #9'background-color: #eeeeee;'
          '}'
          ''
          '/* Nazwa strony */'
          'h1.pageName {'
          #9'text-align: center;'
          #9'color: white;'
          #9'background-color: black;'
          '}'
          ''
          '/* Dodatkowy opis */'
          '.description {'
          #9'text-align: center;'
          #9'margin-bottom: 2em;'
          '}'
          ''
          '/* Tabela ze spisem tre'#347'ci */'
          'table.contents {'
          #9'width: 80%;'
          #9'margin-left: auto;'
          #9'margin-right: auto;'
          #9'border: 0px dashed black;'
          '}'
          ''
          '/* Wiersz z nag'#322#243'wkami kolumn: Grupy, Wyk'#322'adowcy, Zasoby */'
          'tr.contentsHeader {'
          #9'text-align: center;'
          #9'background-color: silver;'
          '}'
          ''
          '/* Kolumna z list'#261' rozk'#322'ad'#243'w */'
          'td.contentsColumn {'
          #9'vertical-align: top;'
          #9'border: 1px dashed silver;'
          '}'
          ''
          '/* Data aktualizacji */'
          '.lastUpdate {'
          #9'margin-top: 1em;'
          #9'font-size: smaller;'
          '}'
          ''
          '/* Dodatkowe informacje (iKalendarz) */'
          '.extraText {'
          #9'margin-top: 3em;'
          #9'font-size: smaller;'
          '}'
          ''
          '#container ul.menu {'
          #9'margin: 5;'
          '}'
          ''
          '#container ul.menu a {'
          #9'display: block;'
          #9'color: #333333;'
          #9'text-decoration: none;'
          
            #9'outline: none; padding-left:0; padding-right:0; padding-top:2px' +
            '; padding-bottom:2px;'
          '}'
          ''
          '#container ul.menu a:hover,'
          '#container ul.menu a:active,'
          '#container ul.menu a:focus {'
          #9'color: #333333;'
          #9'background: #DDDDDD repeat-x bottom;'
          #9'text-decoration: none;'
          '}'
          '')
        ScrollBars = ssBoth
        TabOrder = 0
        WordWrap = False
      end
    end
  end
