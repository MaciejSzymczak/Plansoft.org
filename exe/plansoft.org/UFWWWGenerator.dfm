    object TabSheet2: TTabSheet
      Caption = 'Zaawansowane - uk'#322'ad'
      ImageIndex = 1
      object xslt: TMemo
        Left = 0
        Top = 41
        Width = 1480
        Height = 453
        Align = alClient
        Lines.Strings = (
          '<?xml version="1.0" encoding="windows-1250" ?>'
          
            '<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/' +
            'XSL/Transform">'
          '  <xsl:output method="html"/>'
          '  '
          '  <xsl:template match="xml">'
          '      <html>'
          '       <HEAD>'
          
            '        <link rel="stylesheet" href="menu.css" type="text/css" /' +
            '>'
          '        <xsl:for-each select = "title">'
          '          <title>'
          '            <xsl:value-of select="@name"/> '
          '          </title>'
          '        </xsl:for-each>'
          '       </HEAD>'
          '       <body>'
          '             <xsl:apply-templates/>'
          '       </body>'
          '      </html>'
          '  </xsl:template>'
          ''
          ''
          '  <xsl:template match="period">'
          '  <h1 class="pageName"><xsl:value-of select="@name"/></h1>'
          '   </xsl:template>'
          ''
          '  <xsl:template match="description">'
          '    <div class="description"><xsl:value-of select="@text"/></div>'
          '  </xsl:template>'
          ''
          '  <xsl:template match="data">'
          '    <TABLE BORDER="1" class="contents">'
          '    <TR class="contentsHeader">'
          '        <xsl:if test="//data/gro">'
          '        <TD>Grupy</TD>'
          '        </xsl:if>'
          '        <xsl:if test="//data/lec">'
          '        <TD>Wyk'#322'adowcy</TD>'
          '        </xsl:if>'
          '        <xsl:if test="//data/res">'
          '        <TD>Zasoby</TD>'
          '        </xsl:if>'
          '    </TR>'
          '    <TR>'
          '    <xsl:if test="//data/gro">'
          '    <TD class="contentsColumn">'
          '     <div id="container">'
          '       <ul class="menu">'
          '         <xsl:for-each select = "gro">'
          '          <a>'
          
            '            <xsl:attribute name="href"><xsl:value-of select="@hr' +
            'ef"/></xsl:attribute>'
          '           <xsl:value-of select="@text"/>'
          '          </a>'
          '         </xsl:for-each>'
          '       </ul>'
          '     </div>'
          '    </TD>'
          '    </xsl:if>'
          '    <xsl:if test="//data/lec">'
          '    <TD class="contentsColumn">'
          '     <div id="container">'
          '       <ul class="menu">'
          '         <xsl:for-each select = "lec">'
          '          <a>'
          
            '            <xsl:attribute name="href"><xsl:value-of select="@hr' +
            'ef"/></xsl:attribute>'
          '           <xsl:value-of select="@text"/>'
          '          </a>'
          '         </xsl:for-each>'
          '       </ul>'
          '     </div>'
          '    </TD>'
          '    </xsl:if>'
          '    <xsl:if test="//data/res">'
          '    <TD class="contentsColumn">'
          '     <div id="container">'
          '       <ul class="menu">'
          '         <xsl:for-each select = "res">'
          '          <a>'
          
            '            <xsl:attribute name="href"><xsl:value-of select="@hr' +
            'ef"/></xsl:attribute>'
          '           <xsl:value-of select="@text"/>'
          '          </a>'
          '         </xsl:for-each>'
          '       </ul>'
          '     </div>'
          '    </TD>'
          '    </xsl:if>'
          '    </TR>'
          '    </TABLE>'
          '  </xsl:template>'
          ''
          '  <xsl:template match="who">'
          '    <div class="lastUpdate"><xsl:value-of select="@lastupdatetext"/></div>'
          '  </xsl:template>'
          ''
          '  <xsl:template match="extraText">'
          '    <div class="extraText"><xsl:value-of select="@text"/></div>'
          '  </xsl:template>'
          ''
          '  <xsl:template match="href1">'
          
            '  <br/><a href="{@href}" target="_blank"><xsl:value-of select="@' +
            'text"/></a>'
          '  </xsl:template>'
          ''
          '  <xsl:template match="href2">'
          
            '  <br/><a href="{@href}" target="_blank"><xsl:value-of select="@' +
            'text"/></a>'
          '  </xsl:template>'
          ''
          '  <xsl:template match="href3">'
          
            '  <br/><a href="{@href}" target="_blank"><xsl:value-of select="@' +
            'text"/></a>'
          '  </xsl:template>'
          ''
          '</xsl:stylesheet>'
          ''
          '')
        ScrollBars = ssBoth
        TabOrder = 0
        WordWrap = False
      end
