      object tsGoogle: TTabSheet
        Caption = 'Google Kalendarz - ustawienia'
        ImageIndex = 1
        object IcssqlHolder: TMemo
          Left = 600
          Top = 0
          Width = 25
          Height = 25
          Lines.Strings = (
            'select to_char(day,'#39'yyyy'#39') day_yyyy'
            '     , to_char(day,'#39'mm'#39') day_mm'
            '     , to_char(day,'#39'dd'#39') day_dd'
            '     , day'
            '     , hour'
            '     , fill'
            
              '     , (select listagg(title || '#39' '#39' || first_name || '#39' '#39' || last' +
              '_name,'#39'; '#39') WITHIN GROUP (ORDER BY lec_cla.id) from lecturers l,' +
              'lec_cla where l.id =lec_id and is_child = '#39'N'#39' and cla_id=c.id) l' +
              'ecturers'
            
              '     , (select listagg(nvl(name,abbreviation),'#39'; '#39') WITHIN GROUP' +
              ' (ORDER BY gro_cla.id) from groups g, gro_cla where g.id =gro_id' +
              ' and is_child = '#39'N'#39' and cla_id=c.id) groups'
            
              '     , (select listagg(r.name||'#39' '#39'||r.attribs_01,'#39'; '#39') WITHIN GR' +
              'OUP (ORDER BY rom_cla.id) from rooms r, rom_cla where r.id = rom' +
              '_id and is_child = '#39'N'#39' and  cla_id=c.id) resources'
            
              '     , (select listagg(r.google_location,'#39'; '#39') WITHIN GROUP (ORD' +
              'ER BY rom_cla.id) from rooms r, rom_cla where r.id = rom_id and ' +
              'is_child = '#39'N'#39' and  cla_id=c.id) google_locations'
            '     , id'
            
              '     , (select avg(colour) from lec_cla,lecturers where lec_cla.' +
              'lec_id = lecturers.id and cla_id = c.id) lcolor'
            
              '     , (select avg(colour) from gro_cla,groups where gro_cla.gro' +
              '_id = groups.id and cla_id = c.id) gcolor'
            
              '     , (select avg(colour) from rom_cla,rooms where rom_cla.rom_' +
              'id = rooms.id and cla_id = c.id) rcolor'
            '     , c.sub_id'
            '     , c.for_id'
            '     ,(select kind from forms where id = c.for_id) FOR_KIND'
            
              '     ,(select abbreviation from subjects where id = c.sub_id) SU' +
              'B_abbreviation'
            '     ,(select name from subjects where id = c.sub_id) SUB_NAME'
            
              '     ,(select colour from subjects where id = c.sub_id) SUB_COLO' +
              'UR'
            '     ,(select colour from forms where id = c.for_id) FOR_COLOUR'
            
              '     ,(select colour from planners where name = c.owner) OWNER_C' +
              'OLOUR'
            
              '     ,(select colour from planners where name = c.created_by) CR' +
              'EATOR_COLOUR'
            '     ,c.colour CLASS_COLOUR'
            
              '     ,(select abbreviation from forms where id = c.for_id) FOR_a' +
              'bbreviation'
            '     ,(select name from forms where id = c.for_id) FOR_NAME'
            '     , desc1'
            '     , desc2'
            '     , desc3'
            '     , desc4'
            '     , calc_lecturers'
            '     , calc_groups'
            '     , calc_rooms'
            '     , calc_lec_ids'
            '     , calc_gro_ids'
            '     , calc_rom_ids'
            '     , calc_rescat_ids'
            '     , created_by'
            '     , owner'
            ' from classes c'
            
              ' where day between (select date_from from periods where id = :pe' +
              'r_id_from1)'
            
              '               and (select date_to   from periods where id = :pe' +
              'r_id_to1)'
            
              '   and hour <= (select hours_per_day from periods where id = :pe' +
              'r_id_from2)'
            
              '   and hour <= (select hours_per_day from periods where id = :pe' +
              'r_id_to2)'
            '   /* 2023.10.04 Exclude reservations like holidays */'
            
              '   and for_id in (select id from forms where kind = '#39'C'#39' or desc2' +
              ' like '#39'%#WIDOCZNA%'#39')'
            '   and owner <> '#39'AUTO'#39
            '')
          TabOrder = 0
          Visible = False
          WordWrap = False
        end
      end
    end
  end
